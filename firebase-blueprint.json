      },
      "required": ["ownerId", "deviceId", "localId", "paymentType", "referenceInvoice", "partyName", "amount", "paymentDateMillis", "paymentMethod", "notes", "recordedBy", "createdAt", "updatedAt"]
    },
    "CashierShiftDoc": {
      "title": "CashierShiftDoc",
      "description": "Cashier register open/close shift reconciliation record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "deviceId": { "type": "string" },
        "localId": { "type": "integer" },
        "cashierName": { "type": "string" },
        "startTimeMillis": { "type": "integer" },
        "endTimeMillis": { "type": "integer" },
        "startingCash": { "type": "number" },
        "cashIn": { "type": "number" },
        "cashOut": { "type": "number" },
        "totalCashSales": { "type": "number" },
        "expectedClosingCash": { "type": "number" },
        "actualClosingCash": { "type": "number" },
        "difference": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "localId", "cashierName", "startTimeMillis", "startingCash", "cashIn", "cashOut", "totalCashSales", "expectedClosingCash", "status", "notes", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserStoreProfile" },
      "description": "Store profile and owner info scoped by Firebase Auth UID."
    },
    "/users/{userId}/cashAccounts/{accountId}": {
      "schema": { "$ref": "CashAccountDoc" },
      "description": "Multi-cash accounts owned by the authenticated store owner."
    },
    "/users/{userId}/cashMutations/{mutationId}": {
      "schema": { "$ref": "CashMutationDoc" },
      "description": "Cash flow mutations owned by the authenticated store owner."
    },
    "/users/{userId}/cashTransfers/{transferId}": {
      "schema": { "$ref": "CashTransferDoc" },
      "description": "Inter-account cash transfers owned by the authenticated store owner."
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": { "$ref": "SaleDoc" },
      "description": "POS sale invoices owned by the authenticated store owner."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "ExpenseDoc" },
      "description": "Operational expenses owned by the authenticated store owner."
    },
    "/users/{userId}/incomes/{incomeId}": {
      "schema": { "$ref": "IncomeDoc" },
      "description": "Non-sales income entries owned by the authenticated store owner."
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "ProductDoc" },
      "description": "Store catalog products owned by the authenticated store owner."
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": { "$ref": "CustomerDoc" },
      "description": "Customers owned by the authenticated store owner."
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": { "$ref": "SupplierDoc" },
      "description": "Suppliers owned by the authenticated store owner."
    },
    "/users/{userId}/debtPayments/{paymentId}": {
      "schema": { "$ref": "DebtPaymentDoc" },
      "description": "Debt and receivable payment records owned by the authenticated store owner."
    },
    "/users/{userId}/shifts/{shiftId}": {
      "schema": { "$ref": "CashierShiftDoc" },
      "description": "Cashier shift open/close records owned by the authenticated store owner."
    }
  }
}
