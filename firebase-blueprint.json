    },
    "DebtPaymentDoc": {
      "title": "DebtPaymentDoc",
      "description": "Receivable or supplier debt payment settlement record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "deviceId": { "type": "string" },
        "localId": { "type": "integer" },
        "paymentType": { "type": "string" },
        "referenceInvoice": { "type": "string" },
        "partyName": { "type": "string" },
