      "required": ["ownerId", "deviceId", "localId", "source", "amount", "incomeDateMillis", "notes", "recordedBy", "createdAt", "updatedAt"]
    },
    "ProductDoc": {
      "title": "ProductDoc",
      "description": "POS catalog item or digital service SKU.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "deviceId": { "type": "string" },
        "localId": { "type": "integer" },
        "barcode": { "type": "string" },
