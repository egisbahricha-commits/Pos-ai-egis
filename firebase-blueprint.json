        "providerAdminFee": { "type": "number" },
        "agentCommission": { "type": "number" },
        "shippingCost": { "type": "number" },
        "additionalFee": { "type": "number" },
        "promoDiscount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "localId", "invoiceNumber", "saleDateMillis", "cashierName", "customerName", "subtotal", "discount", "tax", "finalAmount", "paymentMethod", "amountPaid", "changeAmount", "status", "notes", "storeAdminFee", "providerAdminFee", "agentCommission", "shippingCost", "additionalFee", "promoDiscount", "createdAt", "updatedAt"]
    },
    "ExpenseDoc": {
      "title": "ExpenseDoc",
      "description": "Operational expense record.",
