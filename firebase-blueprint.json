{
  "entities": {
    "UserStoreProfile": {
      "title": "UserStoreProfile",
      "description": "Authenticated owner/store profile and POS store settings synced per user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the store owner." },
        "name": { "type": "string", "description": "Store display name." },
        "address": { "type": "string", "description": "Store street address." },
        "phone": { "type": "string", "description": "Store phone number." },
        "businessType": { "type": "string", "description": "Business model (retail, grosir, keduanya)." },
        "ppnBp": { "type": "integer", "description": "Tax basis points (e.g. 1100 = 11%)." },
        "receiptFooter": { "type": "string", "description": "Receipt footer message." },
        "ownerName": { "type": "string", "description": "Owner display name." },
        "ownerEmail": { "type": "string", "description": "Owner Google account email." },
        "profileUpdatedAtMillis": { "type": "integer", "description": "Client update timestamp in epoch ms." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update (FieldValue.serverTimestamp())." }
      },
      "required": ["ownerId", "name", "address", "phone", "businessType", "ppnBp", "receiptFooter", "ownerName", "ownerEmail", "profileUpdatedAtMillis", "createdAt", "updatedAt"]
    },
    "CashAccountDoc": {
      "title": "CashAccountDoc",
      "description": "Multi-cash drawer/wallet/bank-agent account ledger record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "deviceId": { "type": "string" },
        "localId": { "type": "integer" },
        "accountName": { "type": "string" },
        "balance": { "type": "number" },
        "accountType": { "type": "string" },
        "isActive": { "type": "boolean" },
        "color": { "type": "string" },
        "notes": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "localId", "accountName", "balance", "accountType", "isActive", "color", "notes", "isDefault", "sortOrder", "createdAt", "updatedAt"]
    },
    "CashMutationDoc": {
      "title": "CashMutationDoc",
      "description": "Cash flow mutation entry for real-time cash monitoring across devices.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "deviceId": { "type": "string" },
        "localId": { "type": "integer" },
        "cashAccountId": { "type": "integer" },
        "accountName": { "type": "string" },
        "amount": { "type": "number" },
        "mutationType": { "type": "string" },
        "refType": { "type": "string" },
        "refId": { "type": "string" },
        "notes": { "type": "string" },
        "mutationTimeMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "localId", "cashAccountId", "accountName", "amount", "mutationType", "refType", "refId", "notes", "mutationTimeMillis", "createdAt", "updatedAt"]
    },
    "CashTransferDoc": {
      "title": "CashTransferDoc",
      "description": "Inter-account cash transfer record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "deviceId": { "type": "string" },
        "localId": { "type": "integer" },
        "fromAccountName": { "type": "string" },
        "toAccountName": { "type": "string" },
        "amount": { "type": "number" },
        "notes": { "type": "string" },
        "transferDateMillis": { "type": "integer" },
        "loggedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "localId", "fromAccountName", "toAccountName", "amount", "notes", "transferDateMillis", "loggedBy", "createdAt", "updatedAt"]
    },
    "SaleDoc": {
      "title": "SaleDoc",
