      "properties": {
        "ownerId": { "type": "string" },
        "deviceId": { "type": "string" },
        "localId": { "type": "integer" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "expenseDateMillis": { "type": "integer" },
        "notes": { "type": "string" },
        "paymentSource": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "localId", "category", "amount", "expenseDateMillis", "notes", "paymentSource", "recordedBy", "createdAt", "updatedAt"]
    },
    "IncomeDoc": {
      "title": "IncomeDoc",
