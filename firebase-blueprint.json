        "allowDecimalQty": { "type": "boolean" },
        "isFlexiblePrice": { "type": "boolean" },
        "specialPrice": { "type": "number" },
        "strikePrice": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "localId", "barcode", "name", "category", "baseUnit", "purchasePrice", "sellingPrice", "stock", "minStock", "productType", "isActive", "hasNoStock", "allowDecimalQty", "isFlexiblePrice", "createdAt", "updatedAt"]
    },
    "CustomerDoc": {
      "title": "CustomerDoc",
      "description": "Customer record including receivables and loyalty points.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "deviceId": { "type": "string" },
        "localId": { "type": "integer" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "totalReceivable": { "type": "number" },
        "depositBalance": { "type": "number" },
        "loyaltyPoints": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "localId", "name", "phone", "address", "notes", "totalReceivable", "depositBalance", "loyaltyPoints", "createdAt", "updatedAt"]
    },
    "SupplierDoc": {
