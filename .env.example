# SUPABASE_URL: URL proyek Supabase Anda (Settings -> Data API -> Project URL)
SUPABASE_URL=SUPABASE_URL_PLACEHOLDER
# SUPABASE_ANON_KEY: Publishable / Anon Key Supabase Anda (Settings -> API Keys -> anon public)
SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_PLACEHOLDER

# GEMINI_API_KEY: Opsional (tidak dipakai fitur inti KASLITE)
# GEMINI_API_KEY=MY_GEMINI_API_KEY
